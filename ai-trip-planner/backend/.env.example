# --- TripBuddy Backend Configuration ---
# Copy this file to ".env" and adjust values for your environment.

# Admin credentials used by POST /api/auth/login
ADMIN_USERNAME=admin
# PBKDF2-SHA256 hash of the admin password.
# Default below hashes "admin123". Generate your own with:
#   python -c "from app.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$tripbuddy$ae685ed420b5c1ac7150986f22b0ca47adbe9d5880ff24ed6756fe32d1e71981

# Secret used to sign JWT session tokens (any long random string).
# If unset, an ephemeral random secret is generated on each server start.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds (default: 7 days)
JWT_EXPIRY_SECONDS=604800

# Comma-separated list of allowed CORS origins (the frontend dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
